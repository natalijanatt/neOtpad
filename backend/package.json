{
  "name": "@hackaton/backend",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS backend. OpenAPI spec in ../contracts is generated from this code and is the single source of truth.",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:integration": "ts-node -P tsconfig.json scripts/reports-test-db.ts",
    "db:types:test": "ts-node -P tsconfig.json scripts/reports-test-db.ts --types",
    "provision:staff": "ts-node -P tsconfig.json scripts/provision-reporting.ts staff",
    "provision:intermediary": "ts-node -P tsconfig.json scripts/provision-reporting.ts intermediary",
    "cleanup:rate-limits": "ts-node -P tsconfig.json scripts/provision-reporting.ts cleanup-limits",
    "cleanup:photos": "ts-node -P tsconfig.json scripts/provision-reporting.ts cleanup-photos",
    "storage:check": "ts-node -P tsconfig.json scripts/check-storage.ts",
    "typecheck": "tsc --noEmit",
    "db:types": "kysely-codegen --dialect postgres --include-pattern \"app.*\" --out-file src/database/generated/schema.ts",
    "openapi:generate": "ts-node -P tsconfig.json scripts/generate-openapi.ts",
    "import:naselja": "ts-node -P tsconfig.json scripts/import-naselja.ts",
    "import:deponije": "ts-node -P tsconfig.json scripts/import-deponije.ts",
    "forecast:run": "ts-node -P tsconfig.json scripts/run-forecast.ts",
    "classify:run": "ts-node -P tsconfig.json scripts/run-classification.ts",
    "contract:lint": "spectral lint ../contracts/openapi.json --ruleset .spectral.yaml --fail-severity=error",
    "contract:check": "npm run openapi:generate && npm run contract:lint && git diff --exit-code -- ../contracts/openapi.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.0.0",
    "@vercel/functions": "^3.9.8",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "kysely": "^0.28.17",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@stoplight/spectral-cli": "^6.11.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "kysely-codegen": "^0.20.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.2"
  }
}
