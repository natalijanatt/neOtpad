{
  "name": "@hackaton/frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "React frontend. All HTTP calls go through the client generated from @hackaton/api-contract.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "api:generate": "openapi-typescript ./node_modules/@hackaton/api-contract/openapi.json --output src/api/generated/schema.ts",
    "api:check": "npm run api:generate && git diff --exit-code -- src/api/generated",
    "mock": "prism mock ./node_modules/@hackaton/api-contract/openapi.json --port 4010 --errors",
    "data:hotspots": "node scripts/build-hotspots.mjs",
    "data:naselja": "node scripts/build-naselja.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@hackaton/api-contract": "file:../contracts",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.103.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.47.0",
    "openapi-fetch": "^0.13.0",
    "radix-ui": "^1.6.7",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router": "^7.18.4",
    "recharts": "^3.8.0",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@stoplight/prism-cli": "^5.12.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "openapi-typescript": "^7.5.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.0"
  }
}
