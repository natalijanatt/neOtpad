# Kopiraj u frontend/.env.local (git ga ignoriše).

# Bez ove promenljive klijent gađa Prism mock na :4010 (`npm run mock`).
# Pravi backend lokalno: http://localhost:3000
VITE_API_BASE_URL=http://localhost:3000

# Demo nalog za ekran /operativa/login: kad su oba polja popunjena, dugme
# „Brza prijava“ radi jednim klikom. VAŽNO: ove promenljive SAMO popunjavaju
# formu — nalog mora prvo stvarno postojati u app.korisnik, inače je 401 bez
# obzira šta ovde piše (backend nema podrazumevani/seed nalog).
#
# Koraci, jednom po bazi na koju backend gađa (proveri DATABASE_URL u
# backend/.env — lokalna ili cloud, provision ide na tu istu):
#   1. cd backend
#   2. STAFF_EMAIL=<email> STAFF_NAME="<ime>" STAFF_ROLE=admin \
#        STAFF_PASSWORD=<lozinka, 12-128 karaktera> npm run provision:staff
#      (docs/reports-mvp.md — nalog se pravi samo jednom po email-u, postojeći
#      se nikad ne prepisuje; za novu lozinku treba nov email ili ručna izmena
#      hash-a u bazi)
#   3. Upiši ISTI email i lozinku ispod.
#   4. Restartuj `npm run dev` da Vite pokupi .env.local.
VITE_STAFF_EMAIL=
VITE_STAFF_PASSWORD=
